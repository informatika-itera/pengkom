{
  "name": "pkom-slides",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pengenalan Komputasi — slide decks (Reveal.js + React)",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/run-snippets.ts --check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:palette": "bun scripts/gen-palette.ts",
    "gen:outputs": "bun scripts/run-snippets.ts",
    "check:outputs": "bun scripts/run-snippets.ts --check",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/material-symbols-rounded": "^5.3.9",
    "@revealjs/react": "0.2.2",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reveal.js": "^6.0.2",
    "shiki": "^4.0.0"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
